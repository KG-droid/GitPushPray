# Copy this file to .env (which git ignores) and fill in real values.
# Server-side only: never prefix these with VITE_, or Vite would ship them to the browser.

# Your team's Claude Platform API key. Without it, the assistant uses scripted offline answers.
ANTHROPIC_API_KEY=

# Optional: override the assistant model (default claude-haiku-5-5).
ASSISTANT_MODEL=

# Live Claude is only used for requests that carry this code (the judges' QR link ends in /?k=<code>).
# Everyone else gets scripted offline answers. `SET_KEY=1 ./scripts/deploy-azure.sh` makes one if this is blank.
DEMO_ACCESS_CODE=

# Optional limits (defaults: 20 live requests per minute per address, 500 per day in total).
RATE_LIMIT_PER_MINUTE=
DAILY_LIVE_LIMIT=

# Set to 1 to let the admin page's suggested changes use live Claude too (off by default).
INSIGHTS_LIVE=

# Where shared demos are kept so they survive a restart. Unset keeps them in memory only. The deploy script sets /home/data on Azure.
DATA_DIR=
